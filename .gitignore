# Archivos de configuración con credenciales.
# El patrón es amplio a propósito: connections-cliente.json, connections.bak.json
# y cualquier variante quedan afuera. Solo el template se versiona.
connections*.json
!connections.template.json

# Bundles generados
dist/
*.mcpb

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

