{
  "_comment": "Copy to connections.json (or ~/.mcp-sqlserver/connections.json) and edit. Only 'name' and 'server' are required. Any string may reference an environment variable with the env: placeholder syntax shown below, so passwords need not live in this file.",

  "connections": [
    {
      "name": "local-dev",
      "connectionGroup": "Development",
      "description": "Local development database",
      "server": "localhost",
      "database": "MyDatabase",
      "user": "sa",
      "password": "${env:LOCAL_SQL_PASSWORD}",
      "port": 1433,
      "encrypt": false,
      "trustServerCertificate": true
    },
    {
      "name": "acme-prod",
      "connectionGroup": "Acme Corp",
      "description": "Production - head office",
      "server": "192.168.1.10\\SQLEXPRESS",
      "database": "AcmeDB_Prod",
      "user": "app_reader",
      "password": "${env:ACME_PROD_PASSWORD}",
      "port": 1433,
      "encrypt": true,
      "trustServerCertificate": false,
      "readOnly": true
    },
    {
      "name": "acme-qa",
      "connectionGroup": "Acme Corp",
      "description": "QA environment",
      "server": "192.168.1.11",
      "database": "AcmeDB_QA",
      "user": "qa_user",
      "password": "${env:ACME_QA_PASSWORD}",
      "port": 1433,
      "encrypt": false,
      "trustServerCertificate": true
    },
    {
      "name": "warehouse-domain-auth",
      "connectionGroup": "Analytics",
      "description": "Data warehouse over Windows domain (NTLM) authentication",
      "server": "datawarehouse.corp.local",
      "database": "DWH_Main",
      "domain": "CORP",
      "user": "svc_analytics",
      "password": "${env:DWH_PASSWORD}",
      "port": 1433,
      "encrypt": true,
      "trustServerCertificate": true,
      "readOnly": true
    },
    {
      "name": "azure-sql",
      "connectionGroup": "Analytics",
      "description": "Azure SQL Database over Entra ID",
      "server": "myserver.database.windows.net",
      "database": "reporting",
      "encrypt": true,
      "authentication": {
        "type": "azure-active-directory-password",
        "options": {
          "userName": "${env:AZURE_SQL_USER}",
          "password": "${env:AZURE_SQL_PASSWORD}"
        }
      }
    }
  ]
}
